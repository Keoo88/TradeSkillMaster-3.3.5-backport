<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<!-- Trimmed bundled !!!ClassicAPI: only the files TSM actually consumes (plus their load-time/runtime
	     dependencies) are kept. Relative load order is unchanged from the upstream Load.xml so every
	     load-time dependency still precedes its dependent. Removed: raid/combat/unit/talent/quest/voice/
	     gossip/map/pvp shims, object pools, callback registries, atlas/nineslice/pixel/texture UI helpers,
	     and the Templates/ + Texture/ folders (TSM uses native SetBackdrop/UIPanelButtonTemplate; the only
	     bundled textures were consumed solely by the now-removed AtlasInfo + the unloaded Templates). -->

	<!-- Foundation: Constants (WOW_PROJECT_*), ClassicAPI (Private.Tooltip/Void/TEXTURE_PATH + scan tooltip) -->
	<Script file="Util\Constants.lua" />
	<Script file="Util\ClassicAPI.lua" />

	<!-- Enums + item-class lookup tables (Enum.__ItemClassInfo / __InventoryTypeInfo) -->
	<Script file="Util\Enum.lua" />
	<Script file="Util\EnumSupport.lua" />

	<Script file="Util\SoundKit.lua" />
	<Script file="Util\C_Timer.lua" />

	<!-- EventHandler defines Private.EventHandler, required at load by WidgetAPI / C_Spell / ItemUtil -->
	<Script file="Util\EventHandler.lua" />
	<Script file="Util\WidgetAPI.lua"/>

	<!-- Cooldown sets Private.CooldownCapture, read at runtime by WidgetAPI's Cooldown.SetSwipeTexture -->
	<Script file="Util\Cooldown.lua" />

	<!-- C_Texture: WidgetAPI.SetAtlas reads C_Texture.AtlasData at runtime -->
	<Script file="Util\C_Texture.lua" />

	<Script file="Util\C_FriendList.lua" />
	<Script file="Util\C_ChatInfo.lua" />
	<Script file="Util\C_Spell.lua" />
	<Script file="Util\C_Item.lua" />
	<Script file="Util\C_Container.lua" />

	<!-- Mixin must precede Color / ColorUtil / ItemLocation / ItemUtil (CreateFromMixins) -->
	<Script file="Util\Mixin.lua" />
	<Script file="Util\Color.lua" />
	<Script file="Util\ColorUtil.lua" />

	<!-- API: defines securecallfunction / Ambiguate / FormatLargeNumber (used by TSM + embedded ChatThrottleLib;
	     NOT native on 3.3.5a). MathUtil.Round is used at runtime by WidgetAPI FontString methods. -->
	<Script file="Util\API.lua" />
	<Script file="Util\MathUtil.lua" />

	<Script file="Util\ItemLocation.lua" />
	<Script file="Util\ItemUtil.lua" />
</Ui>
