<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<!-- Bundled !!!ClassicAPI fallback. Loads the full upstream Util set in its original order so the global
	     surface is exactly what the standalone addon provides (no missing-global surprises). _Prelude must be
	     first: it sets __TSM_ClassicAPI_SKIP (every other file early-returns when the external addon is present)
	     and an isolated private table so the files never touch TSM's addon object. The Templates/ and Texture/
	     folders are intentionally NOT shipped/loaded: on 3.3.5a SetBackdrop / UIPanelButtonTemplate are native,
	     TSM uses no dropdown/InterfaceOptions templates, and the virtual XML templates would risk a redefinition
	     error alongside the external addon. -->
	<Script file="Util\_Prelude.lua" />

	<Script file="Util\Constants.lua" />
	<Script file="Util\ClassicAPI.lua" />
	<Script file="Util\TooltipSupport.lua" />
	<Script file="Util\TableUtil.lua" />
